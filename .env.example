# ========================================================
# FLAPPY CHAOS: ENVIRONMENT CONFIGURATION
# ========================================================

# Supabase Public Configuration (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (Used ONLY on Server for secure score validation - NEVER expose in client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Game Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin PIN — change this to your own secret before deploying to Vercel
NEXT_PUBLIC_ADMIN_PIN=your_secret_pin_here
